# ====================================================================
# NugaCore — Plantilla de variables de entorno
# Copia este archivo a `.env` para desarrollo local.
# Para producción usa `.env.production.example` como referencia.
#
# Convención de flags booleanos: "true" / "false" (texto).
# ====================================================================

# --- Runtime principal -------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# PUBLIC_DEPLOYMENT: marca un despliegue accesible desde internet (staging/prod).
# En true activa HSTS/CSP/trust-proxy, el fail-fast de arranque y los secretos
# de webhook OBLIGATORIOS aunque NODE_ENV no sea 'production'. En dev: false.
PUBLIC_DEPLOYMENT=false
# WEBHOOK_SECRET_MANUAL / _MERCADO_PAGO / _OPENPAY: secreto HMAC-SHA256 por
# proveedor. En un despliegue público, un webhook sin su secreto se rechaza.
# WEBHOOK_SECRET_MANUAL=

# --- OpenPay -----------------------------------------------------------
# Las credenciales OpenPay se configuran POR WISP en Sistema → Integraciones y
# se guardan cifradas (wisp_integration_settings). Estas variables son solo
# FALLBACK del WISP por defecto (single-WISP); nunca aplican a otro tenant.
# Sin credenciales utilizables, el provider opera en modo simulado.
# OPENPAY_MERCHANT_ID=
# OPENPAY_PRIVATE_KEY=
# OPENPAY_SANDBOX=true

# --- Logging -----------------------------------------------------------
# LOG_LEVEL: debug | info | warn | error  (default: info; debug si NODE_ENV=development)
LOG_LEVEL=debug
# LOG_FORMAT: pretty | json  (default: pretty en dev, json en producción)
LOG_FORMAT=pretty

# --- Autenticación -----------------------------------------------------
# AUTH_TRUST_HEADERS: permite que el cliente declare su rol vía x-user-role.
# ⚠️ SOLO para desarrollo. En producción debe ser "false" (ver SECURITY_AUDIT.md S-01).
AUTH_TRUST_HEADERS=true

# --- Gemini (IA, lado servidor) ---------------------------------------
# Vacío => el copiloto usa respuestas de fallback.
GEMINI_API_KEY=

# --- Supabase (servidor) — reservado para Fase 1+ (NO se conecta en Fase 0) ---
SUPABASE_URL=
# Legacy JWT keys (anon / service_role) o nuevas publishable/secret (sb_*)
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
DATABASE_URL=

# --- Supabase (cliente / Vite) — se incrustan en build-time -----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Quick login de staging (Fase 4.3.1) ------------------------------
# 'true' muestra accesos rápidos que SOLO prerellenan el email de los
# usuarios de staging (sin passwords). Dejar vacío/false en producción.
VITE_ENABLE_QUICK_LOGIN=

# --- MikroTik (reservado) ---------------------------------------------
# Clave de cifrado de credenciales. OBLIGATORIA en producción (crypto.ts lanza error si falta).
MIKROTIK_CREDENTIALS_KEY=

# --- MikroTik Worker (Fase 4.6) ---------------------------------------
# Master switch: habilita ejecución real en todos los subsistemas gated.
# NUGACORE_LIVE_MODE=true activa MIKROTIK_WORKER_LIVE, COMMIT, NOTIFICATIONS, etc.
NUGACORE_LIVE_MODE=false

# 'true' habilita lecturas API RouterOS REALES (solo lectura) cuando el router
# tiene credenciales y es alcanzable por la VPN. Por defecto false → simulado.
# El worker NUNCA ejecuta cortes/reactivaciones en esta fase (dry-run).
MIKROTIK_WORKER_LIVE=false
# 'true' ejecuta cortes/reactivaciones reales en routers (requiere MIKROTIK_WORKER_LIVE).
MIKROTIK_WORKER_COMMIT=false
# 'true' usa api-ssl (puerto apiSslPort del router, típ. 8729) en lugar del API
# plano. Requiere MIKROTIK_WORKER_LIVE=true y router con apiSslPort registrado.
MIKROTIK_WORKER_API_TLS=false

# --- NOC Poller (fundación telemetría) --------------------------------
# 'true' ejecuta ciclos periódicos de lectura READ-ONLY y actualiza el
# store en memoria (CPU/RAM/online). No escribe en RouterOS.
NOC_POLLER_ENABLED=false
NOC_POLLER_INTERVAL_MS=120000
IPAM_PROVIDER=mock

# --- SNMP Live (Fase SNMP + factory onboarding) -------------------------
# Activar solo tras piloto CHR/staging autorizado.
SNMP_POLLER_ENABLED=false
SNMP_POLLER_INTERVAL_MS=120000
SNMP_DEFAULT_VERSION=2c

# --- Producción real (gates por subsistema) ---------------------------
NOTIFICATIONS_LIVE=false
NOTIFICATION_WEBHOOK_URL=
AUTOMATION_EXECUTE=false
PROVISIONING_EXECUTE=false
PAYMENTS_ROUTER_LIVE=false
SAFE_COMMAND_QUEUE_LIVE=false
SERVICE_STATUS_LIVE=false

# --- MikroTik VPN administrada (Fase 4.6.0) ---------------------------
# Servidor VPN propio de NugaCore (WireGuard principal / SSTP fallback).
MIKROTIK_VPN_HOST=vpn.nugacore.local      # host del servidor VPN
MIKROTIK_VPN_SERVER_PORT=13231            # puerto (WG udp / SSTP 443)
MIKROTIK_VPN_CIDR=10.10.0.0/24            # red VPN
MIKROTIK_VPN_SERVER_IP=10.10.0.1         # IP del servidor en el túnel
MIKROTIK_MGMT_CIDR=10.0.0.0/24           # red de gestión NugaCore (rutas)
MIKROTIK_ALLOWED_API_CIDR=               # CIDR autorizado a la API (default = red VPN)
MIKROTIK_WG_SERVER_PUBKEY=               # clave pública del servidor WireGuard
MIKROTIK_WG_ENDPOINT=                    # host:port del peer servidor (legacy)

# --- WireGuard Manager (Fase 4.6.1) -----------------------------------
# 'true' persiste servidores/peers/IPAM/rotaciones en Supabase. Por defecto
# false → store en memoria. Las private/preshared keys se cifran con
# MIKROTIK_CREDENTIALS_KEY.
USE_DB_WIREGUARD=false

# --- Router Enrollment (Fase 4.9.2.1) ---------------------------------
# 'true' persiste los enrollments (incl. template_id y template_parameters)
# en Supabase (tabla router_enrollment). Por defecto false → store en memoria.
# El script .rsc NUNCA se persiste (solo script_hash). Passwords PPPoE en
# template_parameters protegidos por RLS deny-by-default + redacción en API.
USE_DB_ROUTER_ENROLLMENT=false
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USER=
MIKROTIK_PASS=

# --- RouterOS Read-Only Lab (PROD-4/PROD-5) ---------------------------
# Selección de provider del RouterOS Read-Only Lab:
#   mock (default)  → datos de laboratorio en memoria.
#   routeros        → lectura REAL (solo lectura) contra un CHR de LAB vía REST.
# Si faltan credenciales o el CHR no responde, cae a mock por fallback seguro.
ROUTEROS_READONLY_PROVIDER=mock
# Conexión al CHR de laboratorio (NO producción). Dejar vacío para forzar mock.
ROUTEROS_HOST=
ROUTEROS_PORT=443
ROUTEROS_USERNAME=
ROUTEROS_PASSWORD=
# Timeout por lectura (ms). Default 4000.
ROUTEROS_TIMEOUT_MS=4000
# Verificación TLS. CHR de lab suele usar self-signed → "false" (default).
# Poner "true" solo si el CHR presenta un certificado de una CA válida.
ROUTEROS_TLS_REJECT_UNAUTHORIZED=false

# ====================================================================
# FEATURE FLAGS POR DOMINIO  (Fase 1+: alternar store en memoria <-> DB)
# En Fase 0 TODOS quedan en "false" (se usa el store en memoria).
# No activar hasta que exista la capa repository del dominio.
# ====================================================================
USE_DB_CUSTOMERS=false
USE_DB_PLANS=false
USE_DB_BILLING=false
USE_DB_SUSPENSION=false
USE_DB_NETWORK=false
USE_DB_FTTH=false
# Inventario ERP (Fase 5.1): true → Supabase (almacenes, items, movimientos,
# transferencias, asignaciones). Requiere 20260622000000_inventory_schema.sql.
# false (default) → store en memoria, contrato API idéntico.
USE_DB_INVENTORY=false
USE_DB_SUPPORT=false
USE_DB_COMMERCIAL=false
USE_DB_PURCHASES=false
USE_DB_FINANCE=false
USE_DB_PAYMENTS=false
USE_DB_MIKROTIK=false
USE_DB_DASHBOARD=false
USE_DB_GIS=false
USE_DB_AUTOMATIONS=false
USE_DB_REPORTS=false
USE_DB_SECURITY=false

# ── WISP OS Staging (OLA 0) ──────────────────────────────────────────
# Marcar true tras backup+restore probado (checklist §14).
STAGING_RESTORE_TESTED=false
# Token opcional para portal cliente en staging (header x-portal-token).
PORTAL_STAGING_TOKEN=

# ── Hardening HTTP (Fase 4.9.2.5) ───────────────────────────────────
# CORS allowlist: orígenes permitidos, separados por coma. Vacío = niega
# todo cross-origin (same-origin sigue funcionando).
CORS_ALLOWED_ORIGINS=
# Rate limiting (default activo fuera de tests).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Límite del body JSON de la API. Default: 100kb.
# Súbelo solo si algún endpoint legítimo necesita payloads mayores.
JSON_BODY_LIMIT=100kb

# Content-Security-Policy (solo producción). CSP_ENABLED=false la desactiva.
# CSP_CONNECT_SRC: orígenes extra para connect-src (p.ej. la URL de Supabase),
# lista separada por comas.
CSP_ENABLED=true
CSP_CONNECT_SRC=
