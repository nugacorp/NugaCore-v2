# NugaCore ERP - Environment Template
# Copy this file to .env for local development.

# Core runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
AUTH_TRUST_HEADERS=true

# Gemini (server-side only)
# Leave empty to use the built-in fallback responses in mock mode.
GEMINI_API_KEY=

# Supabase server variables (reserved for Fase 1+ integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Vite public variables used by frontend helper src/lib/supabase.ts
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Reserved integration placeholders (not used in Fase 0)
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USER=
MIKROTIK_PASS=
MIKROTIK_CREDENTIALS_KEY=
