# ====================================================================
# NUGACORE ERP - ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ====================================================================

# 1. CORE GLOBAL CONFIGURATION
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# 2. GOOGLE GEMINI AI CONFIGURATION (Server-Side)
# Required for advanced NOC diagnostics, Copilot command assist, and smart triggers.
# AI Studio automatically injects this key at runtime on deployed environments.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 3. SUPABASE CLIENT CONNECTIONS (FASE 0 / FASE 1)
# Used for real-time state synchronization, client CRM updates, and core DB queries.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1Ni..."

# 4. DIRECT POSTGRESQL CONNECTION STRING
# For migrations, schema deployments, and heavy CLI script updates.
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# 5. MIKROTIK SIMULATOR CONTROL CREDENTIALS (FASE 8)
# If connecting directly to local labs or edge networks.
MIKROTIK_HOST="10.200.1.1"
MIKROTIK_PORT=8728
MIKROTIK_USER="admin"
MIKROTIK_PASS="nugacorp_secure_router_pass"
