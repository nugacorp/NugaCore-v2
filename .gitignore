node_modules/
build/
dist/
coverage/
!backend/domains/coverage/
!backend/domains/coverage/**
.DS_Store

# Logs y temporales (incluye el log de depuración y su symlink)
*.log
.tmp_claude_debug.log
/latest

# Artefactos temporales de herramientas (Vitest genera estos al correr;
# tsconfig.verify.json lo crea el flujo de verificación on-the-fly).
vitest.config.*.timestamp-*.mjs
tsconfig.verify.json

# Variables de entorno (se ignoran salvo los archivos de ejemplo)
.env*
!.env.example
!.env.production.example
!.env.development.example

# Claves SSH locales del Cloud Agent (nunca commitear)
.cursor/local/
**/.ssh/id_*
**/.ssh/cloud-agent-*
