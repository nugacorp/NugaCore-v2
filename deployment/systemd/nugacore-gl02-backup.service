[Unit]
Description=NugaCore GL-02 encrypted off-site backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/nugacore-production
ExecStart=/opt/nugacore-production/scripts/vps/gl02-backup.sh --execute
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/tmp /root/.config/rclone
UMask=0077
UnsetEnvironment=GL02_TEST_MODE GL02_PRODUCTION_ENV GL02_RCLONE_CONFIG GL02_ROUTEROS_ENV
