# ====================================================================
# NugaCore — Plantilla de variables de entorno para PRODUCCIÓN
# Referencia para el VPS / Coolify. Inyecta estos valores como SECRETS,
# no como un archivo en disco cuando sea posible.
#
# Lo que cambia respecto a desarrollo está marcado con ⚠️.
# ====================================================================

# --- Runtime principal -------------------------------------------------
NODE_ENV=production
PORT=3000
# ⚠️ Dominio público real servido por el reverse proxy (TLS termina ahí).
APP_URL=https://nugacore.tudominio.com

# --- Logging -----------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- Autenticación -----------------------------------------------------
# ⚠️ OBLIGATORIO en producción: nunca confiar en headers del cliente.
AUTH_TRUST_HEADERS=false

# --- Gemini (IA) -------------------------------------------------------
GEMINI_API_KEY=__SECRET__

# --- Supabase (servidor) — reservado para Fase 1+ ---------------------
# En Fase 0 pueden ir vacías (la DB aún no se conecta).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ⚠️ La service-role key da poder TOTAL. Solo en el backend, rótala periódicamente.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Supabase (cliente / Vite, build-time) ----------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Quick login de staging (Fase 4.3.1) ------------------------------
# En PRODUCCIÓN debe quedar vacío/false: oculta cualquier acceso rápido.
VITE_ENABLE_QUICK_LOGIN=false

# --- MikroTik ----------------------------------------------------------
# ⚠️ OBLIGATORIA en producción para cifrar credenciales de routers.
#    Genera 32+ bytes aleatorios, p.ej.: openssl rand -base64 48
MIKROTIK_CREDENTIALS_KEY=__SECRET__

# ====================================================================
# FEATURE FLAGS POR DOMINIO — mantener en "false" hasta Fase 1.
# ====================================================================
USE_DB_CUSTOMERS=false
USE_DB_PLANS=false
USE_DB_BILLING=false
USE_DB_SUSPENSION=false
USE_DB_NETWORK=false
USE_DB_FTTH=false
USE_DB_INVENTORY=false
USE_DB_SUPPORT=false
USE_DB_MIKROTIK=false
USE_DB_DASHBOARD=false
USE_DB_GIS=false
USE_DB_AUTOMATIONS=false
USE_DB_REPORTS=false
USE_DB_SECURITY=false
