# ====================================================================
# NugaCore — Plantilla de variables de entorno para PRODUCCIÓN
# Referencia para el VPS / Coolify. Inyecta estos valores como SECRETS,
# no como un archivo en disco cuando sea posible.
#
# Lo que cambia respecto a desarrollo está marcado con ⚠️.
# ====================================================================

# --- Runtime principal -------------------------------------------------
NODE_ENV=production
PORT=3000
# ⚠️ Dominio público real servido por el reverse proxy (TLS termina ahí).
APP_URL=https://nugacore.tudominio.com

# --- Logging -----------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- Autenticación -----------------------------------------------------
# ⚠️ OBLIGATORIO en producción: nunca confiar en headers del cliente.
AUTH_TRUST_HEADERS=false

# --- Endurecimiento de runtime (C-03) ---------------------------------
# ⚠️ Marca este despliegue como accesible desde internet. Activa HSTS, CSP,
# trust-proxy, el fail-fast de arranque y los secretos de webhook OBLIGATORIOS,
# aunque NODE_ENV no sea exactamente 'production' (p. ej. staging).
PUBLIC_DEPLOYMENT=true

# --- Webhooks de pago (C-01) ------------------------------------------
# ⚠️ En un despliegue público, un webhook SIN su secreto se rechaza (503).
# Define el secreto de cada proveedor que uses (HMAC-SHA256 sobre el body).
WEBHOOK_SECRET_MANUAL=__SECRET__
# WEBHOOK_SECRET_MERCADO_PAGO=__SECRET__
# WEBHOOK_SECRET_OPENPAY=__SECRET__

# --- Gemini (IA) -------------------------------------------------------
GEMINI_API_KEY=__SECRET__

# --- Supabase (servidor) — OBLIGATORIO en producción ------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ⚠️ La service-role key da poder TOTAL. Solo en el backend, rótala periódicamente.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Restore probado (checklist §15) ----------------------------------
# Marcar true SOLO tras backup+restore exitoso documentado.
PRODUCTION_RESTORE_TESTED=false

# --- Observabilidad (Prometheus) --------------------------------------
METRICS_PROMETHEUS_ENABLED=true
METRICS_BEARER_TOKEN=__SECRET__

# --- Supabase (cliente / Vite, build-time) ----------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Quick login de staging (Fase 4.3.1) ------------------------------
# En PRODUCCIÓN debe quedar vacío/false: oculta cualquier acceso rápido.
VITE_ENABLE_QUICK_LOGIN=false

# --- MikroTik ----------------------------------------------------------
# ⚠️ OBLIGATORIA en producción para cifrar credenciales de routers.
#    Genera 32+ bytes aleatorios, p.ej.: openssl rand -base64 48
MIKROTIK_CREDENTIALS_KEY=__SECRET__

# --- RouterOS Read-Only Lab (PROD-4/PROD-5) ---------------------------
# ⚠️ En PRODUCCIÓN debe quedar en "mock". La integración `routeros` es solo
#    para un CHR de LABORATORIO; NO apuntar a routers de producción (RB5009).
ROUTEROS_READONLY_PROVIDER=mock
ROUTEROS_HOST=
ROUTEROS_PORT=443
ROUTEROS_USERNAME=
ROUTEROS_PASSWORD=
ROUTEROS_TIMEOUT_MS=4000
ROUTEROS_TLS_REJECT_UNAUTHORIZED=true

# ====================================================================
# FEATURE FLAGS POR DOMINIO — producción real (OLA 0 cerrada).
# Activar SOLO tras migraciones aplicadas y restore probado.
# ====================================================================
USE_DB_CUSTOMERS=true
USE_DB_PLANS=true
USE_DB_BILLING=true
USE_DB_PAYMENTS=true
USE_DB_SUSPENSION=true
USE_DB_INVENTORY=true
USE_DB_SUPPORT=true
USE_DB_COMMERCIAL=true
USE_DB_PURCHASES=true
USE_DB_FINANCE=true
USE_DB_NETWORK=false
USE_DB_FTTH=false
USE_DB_MIKROTIK=false
IPAM_PROVIDER=mock
USE_DB_DASHBOARD=false
USE_DB_GIS=false
USE_DB_AUTOMATIONS=false
USE_DB_REPORTS=false
USE_DB_SECURITY=false

# WireGuard Manager y Router Enrollment (recomendados para download post-restart).
USE_DB_WIREGUARD=false
USE_DB_ROUTER_ENROLLMENT=true

# NUNCA sin autorización explícita:
MIKROTIK_WORKER_LIVE=false

# ── Hardening HTTP (Fase 4.9.2.5) ───────────────────────────────────
# CORS allowlist OBLIGATORIA en producción (dominios reales del frontend).
CORS_ALLOWED_ORIGINS=https://tu-dominio.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Content-Security-Policy (Fase 6). Desactivable con CSP_ENABLED=false.
# Si el cliente usa Supabase directo, añade su URL a connect-src:
# CSP_CONNECT_SRC=https://<project-ref>.supabase.co
CSP_ENABLED=true
CSP_CONNECT_SRC=
