# ====================================================================
# NugaCore — Plantilla de variables de entorno para PRODUCCIÓN
# Referencia para el VPS / Coolify. Inyecta estos valores como SECRETS.
# ====================================================================

NODE_ENV=production
PORT=3000
APP_URL=https://nugacore.tudominio.com

LOG_LEVEL=info
LOG_FORMAT=json

# ⚠️ OBLIGATORIO: JWT Supabase; nunca confiar en headers del cliente.
AUTH_TRUST_HEADERS=false

GEMINI_API_KEY=__SECRET__

# Supabase producción (obligatorio)
SUPABASE_URL=https://__PROJECT__.supabase.co
SUPABASE_ANON_KEY=__SECRET__
SUPABASE_SERVICE_ROLE_KEY=__SECRET__
SUPABASE_JWKS_URL=
DATABASE_URL=postgresql://...

VITE_SUPABASE_URL=https://__PROJECT__.supabase.co
VITE_SUPABASE_ANON_KEY=__SECRET__
VITE_ENABLE_QUICK_LOGIN=false

# Cifrado credenciales routers (obligatorio)
MIKROTIK_CREDENTIALS_KEY=__SECRET__

# ── Production gates (activar gradualmente tras checklist §11) ────────
NUGACORE_LIVE_MODE=false
MIKROTIK_WORKER_LIVE=false
MIKROTIK_WORKER_COMMIT=false
MIKROTIK_WORKER_API_TLS=false
NOTIFICATIONS_LIVE=false
NOTIFICATION_WEBHOOK_URL=
AUTOMATION_EXECUTE=false
PROVISIONING_EXECUTE=false
PAYMENTS_ROUTER_LIVE=false
SAFE_COMMAND_QUEUE_LIVE=false
SERVICE_STATUS_LIVE=false

ROUTEROS_READONLY_PROVIDER=mock
ROUTEROS_HOST=
ROUTEROS_PORT=443
ROUTEROS_USERNAME=
ROUTEROS_PASSWORD=
ROUTEROS_TIMEOUT_MS=4000
ROUTEROS_TLS_REJECT_UNAUTHORIZED=true

# ── Persistencia crítica (OLA 0) — todos true en producción WISP ─────
USE_DB_CUSTOMERS=true
USE_DB_PLANS=true
USE_DB_BILLING=true
USE_DB_PAYMENTS=true
USE_DB_SUSPENSION=true
USE_DB_INVENTORY=true
USE_DB_SUPPORT=true
USE_DB_COMMERCIAL=true
USE_DB_PURCHASES=true
USE_DB_FINANCE=true
USE_DB_NETWORK=false
USE_DB_FTTH=false
USE_DB_MIKROTIK=false
USE_DB_DASHBOARD=false
USE_DB_GIS=false
USE_DB_AUTOMATIONS=false
USE_DB_REPORTS=false
USE_DB_SECURITY=false
USE_DB_WIREGUARD=false
USE_DB_ROUTER_ENROLLMENT=true
IPAM_PROVIDER=mock

# Restore probado (checklist §14)
STAGING_RESTORE_TESTED=true

# Portal: vacío en producción (solo JWT cliente/staff)
PORTAL_STAGING_TOKEN=

# Pagos reales
MP_ACCESS_TOKEN=__SECRET__
WEBHOOK_SECRET_MERCADOPAGO=__SECRET__
WEBHOOK_SECRET_OPENPAY=__SECRET__

# HTTP hardening
CORS_ALLOWED_ORIGINS=https://tu-dominio.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
CSP_ENABLED=true
CSP_CONNECT_SRC=https://__PROJECT__.supabase.co
